# Copia este archivo como `.env` y rellena los valores.
# El `.env` real esta en .gitignore y nunca se sube al repositorio.

# Requerida: clave de la API de Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_secreta_aqui

# Opcional en local: si la dejas vacia, el proyecto usa SQLite (db.sqlite3).
# Solo la necesitas si quieres conectarte al Postgres de Supabase desde tu maquina.
# Usa el pooler en session mode (puerto 5432), NO la conexion directa (IPv6).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Opcionales: solo para simular produccion en local.
# DEBUG=False
# ALLOWED_HOSTS=127.0.0.1,localhost
# SECRET_KEY=
